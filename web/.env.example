# Copy to .env.local for local development. Never commit real values.

# Server-only destination for contact-form leads.
# Leave empty locally. A valid submission is acknowledged and not delivered.
# Set this on the host before real leads are expected. Do not invent a URL.
CONTACT_FORM_WEBHOOK_URL=

# Indexing stays off on every *.vercel.app deployment.
# It turns on only when Vercel sets all of these:
#   NODE_ENV=production
#   VERCEL_ENV=production
#   VERCEL_PROJECT_PRODUCTION_URL=adwrks.co.il
# Do not attach adwrks.co.il until that cutover is intentional.
# VERCEL_PROJECT_PRODUCTION_URL is set by Vercel. Do not set it locally to bypass noindex.

# Local WordPress audit scripts only. Not read by the website. Never set on the host.
# scripts/run-migration-audit.js reads WP_USER and WP_PASS.
# scripts/run-phase1b-audit.js reads WP_USER and WP_APP_PASS.
# WP_USER=
# WP_PASS=
# WP_APP_PASS=
