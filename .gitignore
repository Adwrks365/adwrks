# Repo root is the migration workspace. The Next.js app lives in web/
# and keeps its own ignore rules there.

# Root tooling (Playwright was installed here, not inside the app)
/node_modules/

# Secrets. web/.gitignore covers the app directory.

# Case study source PDFs — local archive only (never commit or publish)
geo-measurement/case-study-sources/*.pdf
.env
.env.*
!.env.example

# Local browser and test output
/playwright-report/
/test-results/
/blob-report/
*.log

# Migration QA artifacts (heavy JSON runs, Playwright dumps, scratch HTML)
/migration-audit/phase-*/
/migration-audit/**/*.png
/web/migration-audit/
/web/tmp-*.png
/tmp-*.txt
/tmp-*.html

# Local Lighthouse / PSI batch outputs at repo root
/migration-audit/**/*.json
!/migration-audit/**/README.md

# OS / keys
.DS_Store
Thumbs.db
*.pem
